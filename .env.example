# Trainer/Speaker Configuration
# Uncomment and set the trainer name to display on the speaker slide
# The value should match a JSON filename in common/trainers/ (without the .json extension)

# Examples:
# VITE_TRAINER_NAME=john-doe
# VITE_TRAINER_NAME=jane-smith

# Default trainer (if not set, defaults to 'john-doe')
# VITE_TRAINER_NAME=john-doe
